{
  "name": "@kura/desktop",
  "version": "0.6.43",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "pnpm exec vite",
    "build:main": "bun build ./electron/main.ts --target=node --outfile dist-electron/main.mjs --external electron",
    "build:renderer": "vite build",
    "build": "pnpm build:renderer && pnpm build:main",
    "start": "electron .",
    "package:win": "electron-builder --win portable",
    "package:dir": "electron-builder --win dir",
    "package:installer": "electron-builder --win nsis",
    "package:all": "pnpm run package:installer && pnpm run package:installer:cli && electron-builder --win portable",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prepare:cli": "node ../../scripts/prepare-cli.mjs",
    "package:installer:cli": "pnpm run prepare:cli && electron-builder --config electron-builder.cli.yml --win nsis"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.14"
  },
  "description": "Kura — 番号制本地影片库管理器",
  "author": "Kura"
}
