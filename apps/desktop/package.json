{
  "name": "@kura/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "pnpm exec vite",
    "build:main": "bun build ./electron/main.ts --target=node --outfile dist-electron/main.mjs --external electron",
    "build:renderer": "vite build",
    "build": "pnpm build:renderer && pnpm build:main",
    "start": "electron ."
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^38.0.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0"
  }
}
